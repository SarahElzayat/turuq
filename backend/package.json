{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "User Profile CRUD API — Backend Technical Assessment",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "rimraf dist && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
